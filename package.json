{
  "name": "one-focus",
  "version": "0.11.0",
  "description": "A small, quiet window that keeps you on one thing at a time.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^1.7.2"
  },
  "author": "One Focus",
  "productName": "One Focus",
  "build": {
    "appId": "com.onefocus.app",
    "productName": "One Focus",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "afterPack": "scripts/after-pack.js",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "One-Focus-Setup-${version}.${ext}",
      "shortcutName": "One Focus"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/973lean/one-focus/builds"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
